model XpTransaction {
    id         String   @id @default(cuid())
    userId     String
    amount     Int
    reason     String
    sourceType String
    sourceId   String
    createdAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, sourceType, sourceId])
    @@index([userId, createdAt(sort: Desc)])
}
